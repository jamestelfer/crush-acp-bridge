#!/usr/bin/env python3
"""Record a Crush server SSE trace for the replay tests.

usage: record-trace BASE CWD OUT ACTION PROMPT [PROMPT...]

BASE    the server's base URL: http://host:port or unix:///path/to.sock
CWD     the project directory to open in Crush
OUT     the trace file to write, such as testdata/name.sse
ACTION  the answer to every permission request: allow, allow_session or deny

The script opens CWD as a workspace, sending this process's environment as
Crush clients do, subscribes to the workspace's events, creates a session
titled "trace", and sends each PROMPT in turn, waiting for the assistant's
finish. Every line of the workspace's event stream is written to OUT. The
session ID is printed on stdout; progress goes to stderr.

Questions from Crush's question tool are answered too: yes to a yes_no
question, the first choice of a single_choice or multi_choice question, and
FREE_TEXT_ANSWER to a free_text question.

A turn ends at the trace session's own finish, not a subagent's. With
RECORD_SETTLE=1 set, recording continues after the last turn until every
session descended from the trace session is idle and no event has arrived
for RECORD_QUIET seconds (default 10), so subagent reports and the turns
they wake are captured.
"""

import http.client
import json
import os
import socket
import sys
import threading
import time
import urllib.parse
import uuid

TIMEOUT = 600
TURN_END_REASONS = ("end_turn", "canceled", "error", "max_tokens")
FREE_TEXT_ANSWER = "Recorded answer"


class UnixHTTPConnection(http.client.HTTPConnection):
    """An HTTP connection over a Unix socket."""

    def __init__(self, path, timeout):
        super().__init__("crush", timeout=timeout)
        self.socket_path = path

    def connect(self):
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.sock.settimeout(self.timeout)
        self.sock.connect(self.socket_path)


def connection(base):
    u = urllib.parse.urlsplit(base)
    if u.scheme == "unix":
        return UnixHTTPConnection(u.path, TIMEOUT)
    if u.scheme == "http":
        return http.client.HTTPConnection(u.hostname, u.port or 80, timeout=TIMEOUT)
    raise SystemExit(f"unsupported base URL {base!r}: use http:// or unix://")


def call(base, method, path, body=None):
    c = connection(base)
    payload = json.dumps(body) if body is not None else None
    c.request(method, "/v1" + path, payload, {"Content-Type": "application/json"})
    r = c.getresponse()
    data = r.read()
    if r.status // 100 != 2:
        raise SystemExit(f"{method} {path}: {r.status} {data!r}")
    return json.loads(data) if data.strip() else None


class Tree:
    """The trace session and its descendants, as the event stream reports them."""

    def __init__(self):
        self.lock = threading.Lock()
        self.root = None
        self.parent = {}
        self.busy = {}
        self.last_event = time.monotonic()

    def note_session(self, s):
        with self.lock:
            self.parent[s["id"]] = s.get("parent_session_id") or ""
            self.busy[s["id"]] = bool(s.get("is_busy"))

    def in_tree(self, sid):
        seen = set()
        while sid and sid not in seen:
            if sid == self.root:
                return True
            seen.add(sid)
            sid = self.parent.get(sid, "")
        return False

    def any_busy(self):
        with self.lock:
            return any(b for s, b in self.busy.items() if self.in_tree(s))


def listen(base, ws, client, action, out, tree, turn_done, done, failure):
    try:
        follow(base, ws, client, action, out, tree, turn_done, done)
        if not done.is_set():
            failure.append("the event stream closed before the last turn ended")
    except BaseException as e:  # noqa: BLE001 - reported by the main thread
        failure.append(f"event stream: {e}")
    turn_done.set()


def follow(base, ws, client, action, out, tree, turn_done, done):
    c = connection(base)
    c.request("GET", f"/v1/workspaces/{ws}/events?client_id={client}",
              headers={"Accept": "text/event-stream"})
    r = c.getresponse()
    if r.status // 100 != 2:
        raise SystemExit(f"GET events: {r.status} {r.read()!r}")
    while not done.is_set():
        line = r.readline()
        if not line:
            return
        out.write(line.decode())
        out.flush()
        if not line.startswith(b"data:"):
            continue
        tree.last_event = time.monotonic()
        ev = json.loads(line[5:])
        if ev["type"] == "session":
            tree.note_session(ev["payload"]["payload"])
        elif ev["type"] == "permission_request":
            p = ev["payload"]["payload"]
            print("permission", p["tool_name"], file=sys.stderr)
            call(base, "POST", f"/workspaces/{ws}/permissions/grant",
                 {"action": action, "permission": p})
        elif ev["type"] == "question_batch_request":
            q = ev["payload"]["payload"]
            print("questions", len(q["questions"]), file=sys.stderr)
            call(base, "POST", f"/workspaces/{ws}/questions/answer",
                 {"batch_request_id": q["id"],
                  "responses": [answer(item) for item in q["questions"]]})
        elif ev["type"] == "message":
            m = ev["payload"]["payload"]
            for part in m.get("parts") or []:
                if (part["type"] == "finish" and m["role"] == "assistant"
                        and m.get("session_id") == tree.root
                        and part["data"].get("reason") in TURN_END_REASONS):
                    turn_done.set()


def answer(question):
    """The scripted response to one question of a batch."""
    r = {"request_id": question["id"]}
    kind = question["type"]
    if kind == "yes_no":
        r["yes"] = True
    elif kind in ("single_choice", "multi_choice"):
        r["selected_ids"] = [question["choices"][0]["id"]]
    else:
        r["fill_in_text"] = FREE_TEXT_ANSWER
    return r


def settle(tree, quiet, failure):
    """Wait until the session tree is idle and the stream has been quiet."""
    deadline = time.monotonic() + TIMEOUT
    while not failure:
        if not tree.any_busy() and time.monotonic() - tree.last_event >= quiet:
            print("settled", file=sys.stderr)
            return
        if time.monotonic() > deadline:
            raise SystemExit("timed out waiting for the sessions to settle")
        time.sleep(0.5)


def main(argv):
    if len(argv) < 5:
        raise SystemExit(__doc__)
    base, cwd, out_path, action = argv[:4]
    prompts = argv[4:]
    if action not in ("allow", "allow_session", "deny"):
        raise SystemExit(f"unknown action {action!r}")

    client = str(uuid.uuid4())  # Crush requires a version 4 UUID
    env = [f"{k}={v}" for k, v in os.environ.items()]
    ws = call(base, "POST", "/workspaces", {"path": cwd, "client_id": client, "env": env})["id"]

    tree = Tree()
    turn_done, done, failure = threading.Event(), threading.Event(), []
    with open(out_path, "w", encoding="utf-8") as out:
        t = threading.Thread(target=listen, daemon=True,
                             args=(base, ws, client, action, out, tree, turn_done, done, failure))
        t.start()
        # Subscribe before creating the session, as the bridge does, so the
        # trace opens with the session's "created" event.
        time.sleep(1)
        sid = call(base, "POST", f"/workspaces/{ws}/sessions", {"title": "trace"})["id"]
        tree.root = sid
        # Permission requests reach only the client viewing the session.
        call(base, "POST", f"/workspaces/{ws}/current-session?client_id={client}",
             {"session_id": sid})
        for p in prompts:
            turn_done.clear()
            # listen() records a failure before it sets turn_done, so a
            # failure that the clear above wiped is still caught here.
            if failure:
                raise SystemExit(failure[0])
            call(base, "POST", f"/workspaces/{ws}/agent", {"session_id": sid, "prompt": p})
            if not turn_done.wait(TIMEOUT):
                raise SystemExit("timed out waiting for the turn to end")
            if failure:
                raise SystemExit(failure[0])
            print("turn done", file=sys.stderr)
        time.sleep(1)  # collect the events that follow the finish
        if os.environ.get("RECORD_SETTLE") == "1":
            settle(tree, float(os.environ.get("RECORD_QUIET", "10")), failure)
        if failure:
            raise SystemExit(failure[0])
        done.set()
    print(sid)


if __name__ == "__main__":
    main(sys.argv[1:])
